# Supabase (클라이언트용 — VITE_ 접두사 필수)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (서버 전용)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role 키 — RLS 우회. 로그인/관리 API·시드 스크립트 전용. 절대 VITE_로 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=
# 스태프 서명 토큰(HMAC) 비밀키 — 로그인 성공 시 발급, 관리 API 권한 검증용.
# 32바이트 이상 무작위로(예: openssl rand -base64 48). 약하거나 새면 관리자 토큰 위조 위험.
STAFF_TOKEN_SECRET=
# (선택) 키 로테이션용 과거 비밀키. 쉼표로 여러 개 허용. 무중단 교체 절차:
#   1) STAFF_TOKEN_SECRET_PREVIOUS=<현재키> 로 옮기고 STAFF_TOKEN_SECRET=<새 무작위키> 로 교체·배포
#   2) 기존 발급 토큰(최대 12h)이 모두 만료된 뒤 STAFF_TOKEN_SECRET_PREVIOUS 제거 → 옛키 완전 폐기
# 평소엔 비워둔다. 검증 전용이며, 발급은 항상 STAFF_TOKEN_SECRET로만 한다.
STAFF_TOKEN_SECRET_PREVIOUS=

# 직원 로그인 비밀번호 (평문) — scripts/seed-staff.mjs 실행 시에만 사용.
# 시드 후 DB(staff_users)에 해시로 저장되므로, 시드 완료 후 호스팅에서 삭제 가능.
ADMIN_PW=

# 기준금리 실시간 조회 (한국은행 ECOS OpenAPI, 서버 전용)
# https://ecos.bok.or.kr/api/ 에서 무료 발급. 미설정 시 폴백값(2.75%) 사용.
ECOS_API_KEY=

# 뉴스레터 (서버 전용)
GMAIL_USER=
GMAIL_APP_PASSWORD=
CRON_SECRET=
SITE_URL=https://campus-voice-green-gamma.vercel.app

# 보안 경보 수신 주소(선택) — 대량 삭제 등 비정상 활동 탐지 시 발송. 미설정 시 GMAIL_USER로.
ALERT_EMAIL=
