# Supabase (클라이언트용 — VITE_ 접두사 필수)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (서버 전용)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role 키 — RLS 우회. 로그인/관리 API·시드 스크립트 전용. 절대 VITE_로 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=
# 스태프 서명 토큰(HMAC) 비밀키 — 로그인 성공 시 발급, 관리 API 권한 검증용. 길고 무작위로.
STAFF_TOKEN_SECRET=

# 직원 로그인 비밀번호 (평문) — scripts/seed-staff.mjs 실행 시에만 사용.
# 시드 후 DB(staff_users)에 해시로 저장되므로, 시드 완료 후 호스팅에서 삭제 가능.
ADMIN_PW=

# 기준금리 실시간 조회 (한국은행 ECOS OpenAPI, 서버 전용)
# https://ecos.bok.or.kr/api/ 에서 무료 발급. 미설정 시 폴백값(2.75%) 사용.
ECOS_API_KEY=

# 뉴스레터 (서버 전용)
GMAIL_USER=
GMAIL_APP_PASSWORD=
CRON_SECRET=
SITE_URL=https://campus-voice-green-gamma.vercel.app
